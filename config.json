{
  "include": [
    "multifamily", "multi-family", "apartment", "senior living", "assisted living", "memory care",
    "independent living", "continuing care", "life plan", "active adult", "age-restricted",
    "residential care", "adult care home", "congregate", "retirement community"
  ],
  "exclude": ["single-family", "single family", "self storage", "self-storage", "warehouse", "hotel"],
  "min_units": 100,
  "sources": [
    {
      "name": "Charlotte planning and zoning agendas",
      "type": "legistar",
      "metro": "Charlotte",
      "client": "charlottenc",
      "bodies": ["Zoning", "Planning"],
      "token_env": "LEGISTAR_TOKEN_CHARLOTTE",
      "days_back": 14,
      "days_ahead": 60,
      "enabled": true
    },
    {
      "name": "Chicago building permits",
      "type": "socrata",
      "metro": "Chicago",
      "domain": "data.cityofchicago.org",
      "dataset": "ydr8-5enu",
      "portal_url": "https://data.cityofchicago.org/Buildings/Building-Permits/ydr8-5enu",
      "date_field": "issue_date",
      "id_field": "permit_",
      "type_field": "permit_type",
      "type_contains": "NEW CONSTRUCTION",
      "text_fields": ["work_description", "permit_type"],
      "title_field": "work_description",
      "cost_field": "reported_cost",
      "min_cost": 3000000,
      "address_fields": ["street_number", "street_direction", "street_name"],
      "days_back": 21,
      "enabled": true
    },
    {
      "name": "Dallas building permits",
      "type": "socrata",
      "metro": "Dallas",
      "domain": "www.dallasopendata.com",
      "dataset": "e7gq-4sah",
      "portal_url": "https://www.dallasopendata.com/",
      "date_field": "issued_date",
      "id_field": "permit_number",
      "type_field": "permit_type",
      "type_contains": "NEW",
      "text_fields": ["work_description", "permit_type"],
      "title_field": "work_description",
      "cost_field": "value",
      "min_cost": 3000000,
      "address_fields": ["street_address"],
      "days_back": 21,
      "enabled": false,
      "note": "Dataset id and field names are from memory. Check them on the Dallas portal, then set enabled to true."
    },
    {
      "name": "NC Certificate of Need application logs",
      "type": "nc_con",
      "metro": "North Carolina",
      "index_url": "https://info.ncdhhs.gov/dhsr/coneed/applicationlogs.html",
      "keywords": ["assisted living", "adult care home", "nursing", "memory care", "independent living", "continuing care", "life plan"],
      "max_pdfs": 12,
      "enabled": true
    }
  ]
}
